{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lenso Content Vault Plugin configuration",
  "type": "object",
  "required": [
    "database_url_secret",
    "s3_bucket",
    "s3_region",
    "s3_access_key_id_secret",
    "s3_secret_access_key_secret",
    "quarantine_grace_seconds",
    "sweep_batch_limit",
    "stream_channel_capacity",
    "maintenance_callers"
  ],
  "properties": {
    "database_url_secret": { "$ref": "#/$defs/secretReference" },
    "s3_bucket": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "s3_region": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "s3_endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https?://"
    },
    "s3_access_key_id_secret": { "$ref": "#/$defs/secretReference" },
    "s3_secret_access_key_secret": { "$ref": "#/$defs/secretReference" },
    "s3_session_token_secret": { "$ref": "#/$defs/secretReference" },
    "s3_allow_http": {
      "type": "boolean"
    },
    "quarantine_grace_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 31536000
    },
    "sweep_batch_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "stream_channel_capacity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "maintenance_callers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pluginInstance" }
    }
  },
  "$defs": {
    "secretReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "pluginInstance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["s3_allow_http"],
        "properties": {"s3_allow_http": {"const": true}}
      },
      "then": {
        "required": ["s3_endpoint"],
        "properties": {"s3_endpoint": {"pattern": "^http://"}}
      }
    },
    {
      "if": {
        "required": ["s3_endpoint"],
        "properties": {"s3_endpoint": {"pattern": "^http://"}}
      },
      "then": {
        "required": ["s3_allow_http"],
        "properties": {"s3_allow_http": {"const": true}}
      }
    }
  ],
  "additionalProperties": false
}
