{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lenso Content Vault Plugin configuration",
  "type": "object",
  "required": [
    "database_url_secret",
    "s3_bucket",
    "s3_region",
    "s3_access_key_id_secret",
    "s3_secret_access_key_secret",
    "quarantine_grace_seconds",
    "sweep_batch_limit",
    "stream_channel_capacity",
    "maintenance_callers"
  ],
  "properties": {
    "database_url_secret": { "type": "string" },
    "s3_bucket": {
      "type": "string"
    },
    "s3_region": {
      "type": "string"
    },
    "s3_endpoint": {
      "type": "string"
    },
    "s3_access_key_id_secret": { "type": "string" },
    "s3_secret_access_key_secret": { "type": "string" },
    "s3_session_token_secret": { "type": "string" },
    "s3_allow_http": {
      "type": "boolean"
    },
    "quarantine_grace_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "sweep_batch_limit": {
      "type": "integer",
      "minimum": 1
    },
    "stream_channel_capacity": {
      "type": "integer",
      "minimum": 1
    },
    "maintenance_callers": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
