{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["grant", "target", "content_id", "role"],
  "properties": {
    "grant": {
      "$ref": "#/$defs/OwnerGrant"
    },
    "target": {
      "$ref": "#/$defs/Owner"
    },
    "content_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-8][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
    },
    "role": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Owner": {
      "type": "object",
      "required": ["plugin_instance", "resource_type", "resource_id"],
      "properties": {
        "plugin_instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"
        },
        "resource_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$"
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$"
        },
        "revision_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$"
        }
      },
      "additionalProperties": false
    },
    "OwnerGrant": {
      "type": "object",
      "required": ["tenant_id", "owner", "actor_id", "correlation_id"],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$"
        },
        "owner": {
          "$ref": "#/$defs/Owner"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$"
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F][^\\x00-\\x1F\\x7F]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "title": "ReleaseClaimRequest"
}
