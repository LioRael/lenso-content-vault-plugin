{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["kind", "offset"],
  "properties": {
    "kind": {
      "$ref": "#/$defs/UploadFrameKind"
    },
    "offset": {
      "$ref": "#/$defs/NullableOffset"
    },
    "bytes_base64": {
      "type": ["string", "null"],
      "minLength": 4,
      "maxLength": 11184812,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "x-lenso-sensitive": true
    },
    "content": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContentDescriptor"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ContentDescriptor": {
      "type": "object",
      "required": ["content_id", "sha256", "size_bytes", "media_type", "created_at"],
      "properties": {
        "content_id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[1-8][0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "media_type": {
          "type": "string",
          "minLength": 9,
          "maxLength": 10,
          "pattern": "^(?:image/png|image/jpeg|text/plain)$"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "NullableOffset": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 1073741824
    },
    "UploadFrameKind": {
      "type": "string",
      "enum": ["chunk", "committed"]
    }
  },
  "else": {
    "required": ["content"],
    "properties": {
      "offset": {
        "not": {
          "type": "null"
        }
      },
      "bytes_base64": {
        "type": "null"
      },
      "content": {
        "not": {
          "type": "null"
        }
      }
    }
  },
  "if": {
    "properties": {
      "kind": { "const": "chunk" }
    }
  },
  "then": {
    "required": ["bytes_base64"],
    "properties": {
      "offset": {
        "not": {
          "type": "null"
        }
      },
      "bytes_base64": {
        "not": {
          "type": "null"
        }
      },
      "content": {
        "type": "null"
      }
    }
  },
  "title": "UploadFrame"
}
